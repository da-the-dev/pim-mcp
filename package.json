{
  "name": "pim-mcp",
  "version": "0.1.0",
  "description": "Thin, local MCP server that lets agents manage your calendars across Nextcloud, iCloud, Google and any CalDAV server",
  "mcpName": "io.github.da-the-dev/pim-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "caldav",
    "calendar",
    "icloud",
    "nextcloud",
    "google-calendar",
    "agent"
  ],
  "author": "Aleksey Tkachenko",
  "license": "MIT",
  "homepage": "https://github.com/da-the-dev/pim-mcp#readme",
  "bugs": {
    "url": "https://github.com/da-the-dev/pim-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/da-the-dev/pim-mcp.git"
  },
  "type": "module",
  "bin": {
    "pim-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepare": "tsc",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ical.js": "^2.2.1",
    "smol-toml": "^1.9.1",
    "tsdav": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
